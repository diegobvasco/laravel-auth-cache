{
    "name": "diegobvasco/laravel-auth-cache",
    "description": "This is my package laravel-auth-cache",
    "keywords": [
        "diegobvasco",
        "laravel",
        "laravel-auth-cache"
    ],
    "homepage": "https://github.com/diegobvasco/laravel-auth-cache",
    "license": "MIT",
    "authors": [
        {
            "name": "Diego Vasconcelos",
            "email": "diego_vasconcelos1@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.1.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "DiegoVasconcelos\\AuthCache\\": "src/",
            "DiegoVasconcelos\\AuthCache\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DiegoVasconcelos\\AuthCache\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "lint": "vendor/bin/pint",
        "test:unit": "vendor/bin/pest --parallel --coverage --min=100",
        "test:lint": "vendor/bin/pint --parallel --test",
        "test:types": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": [
            "@test:lint",
            "@test:unit",
            "@test:types"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DiegoVasconcelos\\AuthCache\\AuthCacheServiceProvider"
            ],
            "aliases": {}
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
